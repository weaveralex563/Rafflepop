{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",   // ✅ include server
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts"
  ]
}
